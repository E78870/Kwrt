# dae 完整分流（对齐 ACL4SSR_Online_Full_MultiMode 的分组与覆盖）
global {
    tproxy_port: 12345
    tproxy_port_protect: true
    log_level: info
    lan_interface: br-lan
    wan_interface: auto
    auto_config_kernel_parameter: true
    so_mark_from_dae: 0x04000000
    dial_mode: domain
    sniffing_timeout: 30ms
    tcp_check_url: 'http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111'
    udp_check_dns: 'dns.google:53,8.8.8.8,2001:4860:4860::8888'
    check_interval: 30s
    check_tolerance: 50ms
    tls_implementation: utls
    utls_imitate: chrome_auto
}

subscription {
    # my_sub: 'https://你的订阅'
}

dns {
    upstream { alidns: 'udp://dns.alidns.com:53'
               googledns: 'tcp+udp://dns.google:53' }
    routing {
        request { qname(geosite:cn) -> alidns
                  fallback: googledns }
        response { upstream(googledns) -> accept
                   ip(geoip:private) && !qname(geosite:cn) -> googledns
                   fallback: accept }
    }
}

group {
    # ===== 地区（自动选延迟最低 + 故障切换）=====
    hk { filter: name(keyword:'HK') || name(keyword:'Hong'); policy: min_moving_avg }
    jp { filter: name(keyword:'JP') || name(keyword:'Japan'); policy: min_moving_avg }
    us { filter: name(keyword:'US') || name(keyword:'United') || name(keyword:'America'); policy: min_moving_avg }
    sg { filter: name(keyword:'SG') || name(keyword:'Singapore'); policy: min_moving_avg }
    tw { filter: name(keyword:'TW') || name(keyword:'Taiwan'); policy: min_moving_avg }
    kr { filter: name(keyword:'KR') || name(keyword:'Korea'); policy: min_moving_avg }
    # ===== 策略组（对应 ACL4SSR 的各 policy-group）=====
    proxy     { policy: min_moving_avg }
    auto      { policy: min_avg10 }
    lb        { policy: random }
    telegram  { filter: name(keyword:'SG') || name(keyword:'HK'); policy: min_moving_avg }
    ai        { filter: name(keyword:'US') || name(keyword:'JP'); policy: min_moving_avg }
    streaming { filter: name(keyword:'US') || name(keyword:'JP'); policy: min_moving_avg }
    emby      { filter: name(keyword:'HK') || name(keyword:'TW'); policy: min_moving_avg }
    download  { policy: min_moving_avg }
}

routing {
    # ===== 防环路 / 本地直连 =====
    pname(NetworkManager) -> direct
    pname(dnsmasq) -> must_direct
    pname(netifd) -> must_direct
    pname(daed) -> must_direct
    pname(dae) -> must_direct
    pname(pbr) -> must_direct
    pname(mwan4) -> must_direct
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    dip(geoip:private) -> direct
    dport(123) -> direct
    dport(3478) -> direct
    dport(67, 68) -> direct
    dport(53) -> direct

    # ===== 广告与追踪（ACL4SSR: BanAD / BanProgramAD / AdblockPlus）=====
    domain(geosite:category-ads-all) -> block

    # ===== 微软 / 苹果 / 国内应用直连 =====
    domain(geosite:microsoft) -> direct
    domain(geosite:onedrive) -> direct
    domain(geosite:apple) -> direct
    domain(geosite:cn) -> direct
    dip(geoip:cn) -> direct
    domain(geosite:geolocation-cn) -> direct
    domain(geosite:bilibili) -> direct
    domain(geosite:iqiyi) -> direct
    domain(geosite:youku) -> direct
    domain(geosite:netease) -> direct
    domain(geosite:tencent) -> direct
    domain(geosite:wechat) -> direct
    domain(geosite:alipay) -> direct
    domain(geosite:taobao) -> direct
    domain(geosite:jd) -> direct
    domain(geosite:baidu) -> direct
    domain(geosite:weibo) -> direct
    domain(geosite:zhihu) -> direct

    # ===== 电报（ACL4SSR: 电报消息 + 电报视频）=====
    domain(geosite:telegram) -> telegram

    # ===== AI 应用 =====
    domain(geosite:openai) -> ai
    domain(geosite:anthropic) -> ai
    domain(geosite:category-ai-chat-!cn) -> ai

    # ===== 流媒体（ACL4SSR: 奈飞/迪士尼/YouTube/HBO/Prime/Spotify/TikTok）=====
    domain(geosite:netflix) -> streaming
    domain(geosite:disney) -> streaming
    domain(geosite:hbo) -> streaming
    domain(geosite:primevideo) -> streaming
    domain(geosite:youtube) -> streaming
    domain(geosite:spotify) -> streaming
    domain(geosite:tiktok) -> streaming
    domain(geosite:category-media) -> streaming

    # ===== Emby / 下载 =====
    domain(geosite:category-entertainment) -> emby
    domain(geosite:category-porn) -> download

    # ===== 常用被墙服务 =====
    domain(geosite:google) -> proxy
    domain(geosite:github) -> proxy
    domain(geosite:twitter) -> proxy
    domain(geosite:facebook) -> proxy
    domain(geosite:instagram) -> proxy
    domain(geosite:reddit) -> proxy
    domain(geosite:discord) -> proxy
    domain(geosite:wikimedia) -> proxy
    domain(geosite:cloudflare) -> proxy
    domain(geosite:category-dev) -> proxy
    domain(geosite:category-scholar-!cn) -> proxy

    # ===== 游戏平台（ACL4SSR: 游戏平台）=====
    domain(geosite:steam) -> proxy
    domain(geosite:epicgames) -> proxy
    domain(geosite:category-games) -> proxy

    # ===== ACL4SSR ruleset 逐条对应（33 项）=====
    # 1 LocalAreaNetwork      -> dip(geoip:private)（已在上面）
    # 2 UnBan                 -> 由 geosite:cn/direct 覆盖（dae 无 Clash 的"强制解封"概念）
    # 3 BanAD / 4 BanProgramAD
    domain(geosite:category-ads) -> block
    # 5 GoogleFCM（推送，ACL4SSR 放直连）
    domain(suffix: mtalk.google.com, alt1-mtalk.google.com, alt2-mtalk.google.com) -> direct
    # 6 GoogleCN
    domain(suffix: google.cn, gstatic.cn, googleapis.cn) -> direct
    # 7 SteamCN
    domain(suffix: steamcontent.com, steamstatic.com) -> direct
    # 8 Bing
    domain(suffix: bing.com, bing.net, microsofttranslator.com) -> direct
    # 9 OneDrive / 10 Microsoft / 11 Apple（上面已按 geosite 直连）
    # 12 Telegram（上面已按用途组）
    # 13 AI / 14 OpenAi（上面已按用途组）
    # 15 NetEaseMusic
    domain(suffix: music.163.com, interface.music.163.com) -> direct
    # 16 Epic / 19 Steam / 17 Origin / 18 Sony / 20 Nintendo
    domain(geosite:epicgames) -> proxy
    domain(suffix: origin-a.akamaihd.net, eaassets-a.akamaihd.net) -> proxy
    domain(suffix: playstation.net, playstation.com) -> proxy
    domain(suffix: nintendo.net, nintendo.com, nintendo.co.jp) -> proxy
    # 21 YouTube / 22 Netflix（上面已按 streaming）
    # 23 Bahamut
    domain(suffix: bahamut.com.tw, gamer.com.tw, hinet.net) -> direct
    # 24 BilibiliHMT
    domain(suffix: bilibili.tv) -> direct
    # 25 Bilibili
    domain(geosite:bilibili) -> direct
    # 26 ChinaMedia
    domain(geosite:iqiyi) -> direct
    domain(geosite:youku) -> direct
    # 27 ProxyMedia
    domain(geosite:category-media) -> streaming
    # 28 ProxyGFWlist
    domain(geosite:geolocation-!cn) -> proxy
    # 29 ChinaDomain
    domain(geosite:cn) -> direct
    # 30 ChinaCompanyIp
    dip(geoip:cn) -> direct
    # 31 Download
    domain(geosite:category-porn) -> download
    domain(suffix: download.microsoft.com, steamcontent.com) -> download
    # 32 全球直连 / 33 漏网之鱼 由 direct/cn 与 fallback 承担

    # ===== 兜底（ACL4SSR: 漏网之鱼）=====
    domain(geosite:geolocation-!cn) -> proxy
    fallback: proxy
}
