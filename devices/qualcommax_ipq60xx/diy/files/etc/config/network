config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option packet_steering '0'

# lan1 已从桥里摘出，用作 wanb
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan2'
	list ports 'lan3'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.1.3/24'
	option ip6assign '64'
	option ip6ifaceid 'eui64'
	option multipath 'off'

# 主 WAN（mwan4 权重 3）—— 账号密码请用 /root/set-pppoe.sh 写入
config interface 'wan'
	option device 'wan'
	option proto 'pppoe'
	option username ''
	option password ''
	option ipv6 '1'
	option keepalive '10 3'
	option metric '10'

# 副 WAN（mwan4 权重 2）
config interface 'wanb'
	option device 'lan1'
	option proto 'pppoe'
	option username ''
	option password ''
	option ipv6 '1'
	option keepalive '10 3'
	option metric '20'
