#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
PROG=/opt/subconverter/subconverter
start_service() {
    [ -x "$PROG" ] || return 0
    procd_open_instance
    procd_set_param command "$PROG" --listen 127.0.0.1:25500
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
