# CONFIG_PACKAGE_kmod-iptunnel6 is not set

# ==== 关闭"把 feed 里所有 kmod 都编一遍"（devices/common/.config 里的 ALL_NONSHARED=y 会 select ALL_KMODS）
# 副作用：kiddin9 源里任何坏掉的 kmod 都会拖垮构建（如 kmod-natflow：上游 commit 68cc4c8 已被 force-push 掉）
# 关掉后只编我们真正选中的包与它们的依赖，构建时间也大幅下降
# CONFIG_ALL_NONSHARED is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_PACKAGE_kmod-natflow is not set

# ==== 只编 zn_m2 一个型号
# devices/common/.config 里 CONFIG_TARGET_ALL_PROFILES=y 会把 ipq60xx 所有设备都编一遍，
# 其中 philips_ly1800 等机型 KERNEL_SIZE:=6144k，而开了 DEBUG_INFO+BTF 的 uImage.itb 是 6472096 > 6291456，
# check-size 直接 rm 掉产物 -> target/linux failed to build。
# zn_m2 走 UbiFit（内核进 UBI，无固定 6MB 内核分区），不受此限。
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ==== 预装：多线负载 / 策略路由 / 本地订阅转换（体积约 4 MB，全部来自源或源码）
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_mwan4=y
# subconverter 不编入：源里是 tindy2013 上游版，缺用户 fork(asdlokj1qpi23) 的协议支持
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ip-full=y
# dae/daed 需要的 kmod-veth / kmod-sched-core / kmod-sched-bpf 不编入：
# 它们能从 Kwrt 源装，且只有 dae/daed 用 —— 由 install.sh 自动带进来
# daed/luci-app-daede 不编入：24MB 且更新频繁，改由 /root/install-daede.sh 刷后装到 overlay
# 注意：不选 dae/daed/luci-app-daede
#   daed 23.87MB + geoip 4.17 + geosite 0.67 + vmlinux-btf 1.14 ≈ 29.9MB，
#   而 rootfs 卷仅 33.4MiB、现有镜像 11.0MiB（余量 24.0MiB）→ 放不下。
#   它们改由 /root/install-daede.sh 在刷机后装到 overlay（62.9MB 可用）。
